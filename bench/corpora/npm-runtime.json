{
  "id": "npm-runtime",
  "title": "The installed DSH packages: 6k files, mostly binary, just under the scan budget",
  "class": "runtime",
  "roots": [
    "${repo}/node_modules/@deepseek-ai"
  ],
  "shape": {
    "files": [
      5000,
      7000
    ],
    "mebibytes": [
      200,
      280
    ],
    "maxDepth": [
      8,
      12
    ],
    "binaryBytesRatio": [
      0.5,
      0.9
    ]
  },
  "cases": [
    {
      "id": "grep-miss",
      "tool": "grep",
      "args": {
        "pattern": "BENCH_NEVER_PRESENT_87",
        "path": "."
      }
    },
    {
      "id": "glob-js",
      "tool": "glob",
      "args": {
        "pattern": "**/*.js",
        "path": "."
      }
    }
  ],
  "identity": {
    "files": [
      "${repo}/package-lock.json",
      "${repo}/node_modules/.package-lock.json"
    ],
    "sample": 32
  }
}
